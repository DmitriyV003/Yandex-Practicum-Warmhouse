@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

title Component Diagram - API Gateway

Container_Boundary(api, "API Gateway") {
    Component(handler, "Handler", "Rest API", "Обработка HHTP")
    Component(service, "Service", "Go", "Обогащение данных")
    Component(device_client, "GRPC Client", "Go", "Вызов device service API")
    Component(telemetry_client, "GRPC Client", "Go", "Вызов telemetry service API")
}

Rel(handler, service, "Вызывает")
Rel(service, device_client, "Вызывает")
Rel(service, telemetry_client, "Вызывает")

@enduml
